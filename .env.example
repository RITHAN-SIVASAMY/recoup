# ─── core ────────────────────────────────────────────────────────────────
RECOUP_ENV=local
RECOUP_SEED=42
LOG_LEVEL=INFO

# ─── datastores ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://recoup:recoup@localhost:5432/recoup
REDIS_URL=redis://localhost:6379/0

# ─── razorpay (TEST MODE ONLY) ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# ─── anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-sonnet-4-5
ANTHROPIC_MODEL_DEEP=claude-opus-4-5
LLM_TIMEOUT_SECONDS=8
LLM_REDACTION_ENABLED=true

# ─── channels (all optional — the simulator is the default) ──────────────
CHANNEL_MODE=simulator          # simulator | live
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
RESEND_API_KEY=

# ─── recovery links ──────────────────────────────────────────────────────
LINK_SIGNING_SECRET=change-me
LINK_TTL_HOURS=72
PUBLIC_BASE_URL=http://localhost:3000

# ─── policy / governance ─────────────────────────────────────────────────
POLICY_DIR=./policies
MERCHANT_ID=demo
KILL_SWITCH=false
