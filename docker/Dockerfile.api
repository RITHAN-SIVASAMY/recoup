FROM python:3.12-slim
WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev --no-install-project

COPY src ./src
COPY alembic.ini ./
COPY alembic ./alembic
RUN uv sync --no-dev

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "recoup.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
